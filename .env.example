# Copy to .env in this folder and fill in YOUR OWN values (never Ben's).
# .env is git-ignored. Never paste values into chat, notes, or commits.

# Shopify: one custom app per person per store (see docs/access.md for scopes).
# The Shopify CLI and Shopify AI Toolkit sign in as your staff account and do not need these.
RT_SHOPIFY_DOMAIN=
RT_SHOPIFY_ACCESS_TOKEN=
OS_SHOPIFY_DOMAIN=oh-susannahs-pillowcases.myshopify.com
OS_SHOPIFY_ACCESS_TOKEN=

# Google Search Console (seo-analysis skill). Uses gcloud login or a read-only service account.
GOOGLE_APPLICATION_CREDENTIALS=

# PageSpeed Insights (optional, raises rate limits)
PAGESPEED_API_KEY=
