

{%- liquid
  assign edu_handles = 'science-sources,best-reflective-gear-for-walking-at-night,workshop-kit' | split: ','
  assign body = page.content
  if page.handle == 'science-sources'
    comment
      The page template already prints the title as the H1, so the H1 inside the page body is dropped
      instead of showing the same title twice.
    endcomment
    assign body_parts = page.content | split: '</h1>'
    if body_parts.size > 1
      assign body = ''
      for part in body_parts
        unless forloop.first
          assign body = body | append: part
          unless forloop.last
            assign body = body | append: '</h1>'
          endunless
        endunless
      endfor
    endif
  endif
-%}
<div
  class="page-content{% if edu_handles contains page.handle %} rt-edu-body rt-edu-body--{{ page.handle }}{% endif %}"
  style="
    {% if block.settings.text_color != blank %}
      --color: {{ block.settings.text_color }};
      --color-rgb: {{ block.settings.text_color.rgb }};
    {% endif %}
  "
>
  <rte-formatter>
    {{ body }}
  </rte-formatter>
</div>

{% stylesheet %}
  .page-content {
    color: var(--color, inherit);
  }

  .page-content a {
    color: currentcolor;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.page_content",
  "class": "rte",
  "settings": [
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    }
  ]
}
{% endschema %}
