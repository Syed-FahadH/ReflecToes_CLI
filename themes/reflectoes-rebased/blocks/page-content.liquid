

<div
  class="page-content"
  style="
    {% if block.settings.text_color != blank %}
      --color: {{ block.settings.text_color }};
      --color-rgb: {{ block.settings.text_color.rgb }};
    {% endif %}
  "
>
  <rte-formatter>
    {%- comment -%}
      The page template already prints the title as the H1. A second H1 in the page body
      (science-sources) is shown as an H2 so each page keeps one H1.
    {%- endcomment -%}
    {%- if page.handle == 'science-sources' -%}
      {{ page.content | replace: '<h1', '<h2' | replace: '</h1>', '</h2>' }}
    {%- else -%}
      {{ page.content }}
    {%- endif -%}
  </rte-formatter>
</div>

{% stylesheet %}
  .page-content {
    color: var(--color, inherit);
  }

  .page-content a {
    color: currentcolor;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.page_content",
  "class": "rte",
  "settings": [
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    }
  ]
}
{% endschema %}
