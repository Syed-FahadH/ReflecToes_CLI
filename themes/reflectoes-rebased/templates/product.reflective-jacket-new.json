        "custom_liquid": "<style>\n  .image-stack {\n    width: 100%;\n    display: flex;\n    flex-direction: column;\n  }\n\n  .image-stack picture,\n  .image-stack img {\n    width: 100%;\n    display: block;\n  }\n\n  @media (max-width: 768px) {\n    .image-stack img {\n      aspect-ratio: 4 / 3;\n      object-fit: contain;\n      background-color: #f9f9f9;\n    }\n  }\n</style>\n\n<div class=\"image-stack\">\n\n  <!-- Image 1 (LCP candidate) -->\n  <picture>\n    <source\n      media=\"(max-width: 768px)\"\n      srcset=\"https://cdn.shopify.com/s/files/1/0056/6847/0855/files/Jacket_M1.jpg?width=900\">\n    <img\n      src=\"https://cdn.shopify.com/s/files/1/0056/6847/0855/files/Jacket_1_c82c8499-cd58-4dfb-8b7f-e664248275d5.jpg?width=1600\"\n      alt=\"High visibility reflective waterproof jacket front view designed for cycling, running, and night commuting safety\"\n      width=\"1600\"\n      height=\"1200\"\n      sizes=\"(max-width: 768px) 100vw, 1200px\"\n      loading=\"eager\"\n      fetchpriority=\"high\"\n      decoding=\"async\">\n  </picture>\n\n  <!-- Image 2 -->\n  <picture>\n    <source\n      media=\"(max-width: 768px)\"\n      srcset=\"https://cdn.shopify.com/s/files/1/0056/6847/0855/files/Jacket_M2_b3f9416c-c750-43a5-8e32-fa50f181d095.jpg?width=900\">\n    <img\n      src=\"https://cdn.shopify.com/s/files/1/0056/6847/0855/files/Jacket_2_da0d44e7-4111-4029-b3d6-4cb2a797fccd.jpg?width=1600\"\n      alt=\"Rear view of reflective rain jacket with 360 degree visibility features for cyclists and urban commuters\"\n      width=\"1600\"\n      height=\"1200\"\n      sizes=\"(max-width: 768px) 100vw, 1200px\"\n      loading=\"lazy\"\n      decoding=\"async\">\n  </picture>\n\n  <!-- Image 3 -->\n  <picture>\n    <source\n      media=\"(max-width: 768px)\"\n      srcset=\"https://cdn.shopify.com/s/files/1/0056/6847/0855/files/Jacket_M3.jpg?width=900\">\n    <img\n      src=\"https://cdn.shopify.com/s/files/1/0056/6847/0855/files/Jacket_3_a9a3f0a7-58a6-4e60-81ee-e650e375ff4b.jpg?width=1600\"\n      alt=\"Side profile of lightweight fluorescent reflective jacket showing fit and waterproof commuter design\"\n      width=\"1600\"\n      height=\"1200\"\n      sizes=\"(max-width: 768px) 100vw, 1200px\"\n      loading=\"lazy\"\n      decoding=\"async\">\n  </picture>\n\n  <!-- Image 4 -->\n  <picture>\n<source\n    media=\"(max-width: 768px)\"\n    srcset=\"https://cdn.shopify.com/s/files/1/0056/6847/0855/files/Jacket_m4.jpg?width=900\">\n    <img\n      src=\"https://cdn.shopify.com/s/files/1/0056/6847/0855/files/Jacket4.jpg?width=1600\"\n      alt=\"Close up of reflective rain jacket technical details showing waterproof fabric and high visibility material\"\n      width=\"1600\"\n      height=\"1200\"\n      sizes=\"(max-width: 768px) 100vw, 1200px\"\n      loading=\"lazy\"\n      decoding=\"async\">\n  </picture>\n\n</div>",
        "background_color": "{{ settings.color_palette.background }}",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
