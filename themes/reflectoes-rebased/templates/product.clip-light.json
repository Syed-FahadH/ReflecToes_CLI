                  "blocks": {
                    "txt_why": {
                      "type": "text",
                      "settings": {
                        "text": "<ul><li><strong>Active Light, Not Just Reflection</strong><br/>Three red LEDs spread light across a 180&deg; arc, so drivers can see you even before their headlights reach you.</li><li><strong><a href=\"/pages/biomotion-science\">Bio-Motion Design</a></strong><br/>Our products are built around joint-level placement, where research shows reflective movement is detected by drivers fastest.</li><li><strong>Built for Real Conditions</strong><br/>Designed for night running, winter cycling, and wet commutes, not just casual use.</li><li><strong>Satisfaction Guaranteed</strong><br/>If anything is wrong, contact us and we will make it right. Free US shipping on orders over $50.</li></ul>",
                        "width": "100%",
