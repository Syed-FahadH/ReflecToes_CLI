            "accordion_row_VMFKax": {
              "type": "_accordion-row",
              "settings": {
                "heading": "Do these replace required bike lights?",
                "open_by_default": false,
                "icon": "none",
                "width": 20
              },
              "blocks": {
                "text_VJwfQy": {
                  "type": "text",
                  "name": "t:names.text",
                  "settings": {
                    "text": "<p>No. They are an additional visibility light, not a replacement for legally required bicycle headlight or taillight equipment. Use the solid, quick-flash, or slow-flash mode that fits your activity and conditions.</p>",
                    "width": "100%",
                    "max_width": "normal",
