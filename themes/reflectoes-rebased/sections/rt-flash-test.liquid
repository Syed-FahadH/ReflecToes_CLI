<section class="rtft" id="rtft-{{ section.id }}" aria-labelledby="rtft-h-{{ section.id }}" data-rtft>
  <div class="rtft__wrap">
    <p class="rtft__eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="rtft__h" id="rtft-h-{{ section.id }}">{{ section.settings.heading }}</h2>
    <p class="rtft__lede">{{ section.settings.lede }}</p>

    <div class="rtft__tools">
      <button type="button" class="rtft__toggle" data-rtft-toggle aria-pressed="false">Pause animation</button>
    </div>

    <div class="rtft__methods">
      <article class="rtft__m">
        <p class="rtft__tag">Test 1 · easiest</p>
        <h3>The phone flash photo</h3>
        <svg viewBox="0 0 400 210" role="img" aria-label="Diagram. A phone with its flash on is held across a room from three samples on a hook: a fluorescent fabric, a reflective strip and white cotton. The flash lights all three, and the reflective strip sends a bright return back toward the phone.">
          <line x1="0" y1="186" x2="400" y2="186" stroke="#2b333c" stroke-width="2"/>
          <rect x="40" y="70" width="34" height="62" rx="6" fill="#1d242c" stroke="#59646e" stroke-width="2"/>
          <circle cx="57" cy="80" r="3.5" fill="#9fb3c4"/>
          <circle cx="66" cy="80" r="3" fill="#fff6d8" class="rtft__pulse"/>
          <text x="57" y="152" fill="#a3aeaa" font-size="12" text-anchor="middle">flash and lens</text>
          <text x="57" y="166" fill="#a3aeaa" font-size="12" text-anchor="middle">side by side</text>
          <g class="rtft__pulse" stroke="#fff3c4" stroke-width="2.5" stroke-linecap="round"><line x1="70" y1="80" x2="300" y2="62"/><line x1="70" y1="80" x2="300" y2="100"/><line x1="70" y1="80" x2="300" y2="140"/></g>
          <line x1="318" y1="20" x2="318" y2="186" stroke="#2b333c" stroke-width="3"/>
          <rect x="300" y="52" width="22" height="20" rx="3" fill="#6e7834"/><text x="330" y="66" fill="#a3aeaa" font-size="12">fluorescent</text>
          <rect x="300" y="90" width="22" height="20" rx="3" fill="#c3c7cc"/><text x="330" y="104" fill="#a3aeaa" font-size="12">reflective</text>
          <rect x="300" y="130" width="22" height="20" rx="3" fill="#5d6166"/><text x="330" y="144" fill="#a3aeaa" font-size="12">white cotton</text>
          <g class="rtft__pulse rtft__pulse--late" stroke-linecap="round"><line x1="300" y1="100" x2="62" y2="80" stroke="#fffdf2" stroke-width="5"/><circle cx="311" cy="100" r="16" fill="rgba(255,250,225,.45)"/></g>
          <text x="180" y="200" fill="#a3aeaa" font-size="12" text-anchor="middle">10 ft or more</text>
        </svg>
        <ol>
          <li>Lay your gear out in a dim room, or go outside after dark.</li>
          <li>Step back at least 10 ft.</li>
          <li>Take a photo with the flash forced <strong>on</strong>.</li>
        </ol>
        <p class="rtft__why">Why it works: the flash sits right next to the camera lens, close to where headlights sit below a driver's eyes. Retroreflective material sends light back toward its source, so it can look bright in the photo.</p>
      </article>

      <article class="rtft__m">
        <p class="rtft__tag">Test 2 · the workshop demo</p>
        <h3>Flashlight at your eye</h3>
        <svg viewBox="0 0 400 210" role="img" aria-label="Diagram. A person holds a flashlight at eye level and a reflective strip across the room glows. Holding the flashlight at the hip, away from the eyes, makes the same strip look much dimmer.">
          <line x1="0" y1="186" x2="400" y2="186" stroke="#2b333c" stroke-width="2"/>
          <circle cx="60" cy="50" r="13" fill="#3a434c"/><rect x="50" y="64" width="20" height="62" rx="9" fill="#3a434c"/><rect x="51" y="122" width="8" height="62" rx="4" fill="#3a434c"/><rect x="61" y="122" width="8" height="62" rx="4" fill="#3a434c"/>
          <circle cx="66" cy="48" r="2.5" fill="#e9eeec"/>
          <rect x="72" y="44" width="18" height="8" rx="2" fill="#c9d0d6"/>
          <text x="96" y="36" fill="#d6ff3d" font-size="12">at your eye: bright</text>
          <g class="rtft__pulse" stroke="#fff3c4" stroke-width="2.5"><line x1="90" y1="48" x2="320" y2="110"/></g>
          <g class="rtft__pulse rtft__pulse--late" stroke="#fffdf2" stroke-width="5" stroke-linecap="round"><line x1="320" y1="110" x2="70" y2="49"/></g>
          <rect x="72" y="118" width="18" height="8" rx="2" fill="#5b6672"/>
          <text x="96" y="146" fill="#ff9d8a" font-size="12">at your hip: much dimmer</text>
          <line x1="90" y1="122" x2="320" y2="112" stroke="#6b5b3a" stroke-width="2" stroke-dasharray="4 5"/>
          <line x1="330" y1="40" x2="330" y2="186" stroke="#2b333c" stroke-width="3"/>
          <rect x="318" y="100" width="22" height="22" rx="3" fill="#c3c7cc"/>
          <circle cx="329" cy="111" r="18" fill="rgba(255,250,225,.5)" class="rtft__pulse rtft__pulse--late"/>
        </svg>
        <ol>
          <li>Dim the room. Ask a volunteer to stand across it in their gear.</li>
          <li>Hold a flashlight against your temple and look along the beam. Never shine it into anyone's eyes.</li>
          <li>Now hold it at your hip. The reflective parts dim.</li>
        </ol>
        <p class="rtft__why">Why it works: retroreflective material sends light back toward the light source, so it looks brightest when the light is close to your eyes.</p>
      </article>
    </div>

    <div class="rtft__results">
      <h3>What a flash photo can show</h3>
      <div class="rtft__grid">
        <div class="rtft__s">
          <div class="rtft__pair"><span class="rtft__chip" style="--c:#9ea3a8"><i></i></span><span class="rtft__chip rtft__chip--flash rtft__chip--retro"><i></i></span></div>
          <strong>Retroreflective</strong>
          <span>Dull grey in daylight. Bright white glow in the flash.</span>
        </div>
        <div class="rtft__s">
          <div class="rtft__pair"><span class="rtft__chip" style="--c:#d6ff1e"><i></i></span><span class="rtft__chip rtft__chip--flash" style="--f:#6e7834"><i></i></span></div>
          <strong>Fluorescent yellow</strong>
          <span>Vivid in daylight. A flash has little UV, so it looks ordinary.</span>
        </div>
        <div class="rtft__s">
          <div class="rtft__pair"><span class="rtft__chip" style="--c:#eceae4"><i></i></span><span class="rtft__chip rtft__chip--flash" style="--f:#5d6166"><i></i></span></div>
          <strong>White cotton</strong>
          <span>A little brighter in the flash, with no glow.</span>
        </div>
        <div class="rtft__s">
          <div class="rtft__pair"><span class="rtft__chip" style="--c:#22252b"><i></i></span><span class="rtft__chip rtft__chip--flash" style="--f:#1b1d21"><i></i></span></div>
          <strong>Dark clothing</strong>
          <span>Stays dark in daylight and in the flash.</span>
        </div>
      </div>
      <p class="rtft__legend"><span>Left chip: daylight</span><span>Right chip: flash photo</span></p>
    </div>

    <div class="rtft__care">
      <h3>Before you try it</h3>
      <ul>
        <li>This shows how a material responds to a close light. It is not a measurement of how far a driver can see you.</li>
        <li>Phones adjust exposure and HDR on their own, so photos from different phones are not a fair way to rank materials. Compare items in the same photo.</li>
        <li>Do it away from traffic, and keep the light out of people's eyes.</li>
      </ul>
      {%- if section.settings.cta_link != blank -%}
        <a class="rtft__cta" href="{{ section.settings.cta_link }}">{{ section.settings.cta_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function () {
    if (window.__rtftInit) return;
    window.__rtftInit = true;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    var instances = [];

    function setup(root) {
      if (!root || root.dataset.rtftReady) return;
      root.dataset.rtftReady = '1';
      var btn = root.querySelector('[data-rtft-toggle]');
      var visible = false;
      var paused = false;

      function apply() {
        root.classList.toggle('is-animating', visible && !paused && !reduce.matches);
      }

      if (reduce.matches && btn) btn.hidden = true;

      if (btn) {
        btn.addEventListener('click', function () {
          paused = !paused;
          btn.setAttribute('aria-pressed', paused ? 'true' : 'false');
          btn.textContent = paused ? 'Play animation' : 'Pause animation';
          apply();
        });
      }

      var io = null;
      if ('IntersectionObserver' in window) {
        io = new IntersectionObserver(function (entries) {
          visible = entries[0].isIntersecting;
          apply();
        }, { threshold: 0.15 });
        io.observe(root);
      }

      var onMotion = function () { if (btn) btn.hidden = reduce.matches; apply(); };
      if (reduce.addEventListener) reduce.addEventListener('change', onMotion);
      var onVis = function () { if (document.hidden) { root.classList.remove('is-animating'); } else { apply(); } };
      document.addEventListener('visibilitychange', onVis);

      instances.push({ root: root, destroy: function () {
        if (io) io.disconnect();
        document.removeEventListener('visibilitychange', onVis);
        if (reduce.removeEventListener) reduce.removeEventListener('change', onMotion);
        root.classList.remove('is-animating');
        delete root.dataset.rtftReady;
      } });
    }

    function initAll() { document.querySelectorAll('[data-rtft]').forEach(setup); }
    initAll();

    document.addEventListener('shopify:section:load', function (e) {
      var r = e.target && e.target.querySelector ? e.target.querySelector('[data-rtft]') : null;
      if (r) setup(r);
    });
    document.addEventListener('shopify:section:unload', function (e) {
      instances = instances.filter(function (i) {
        if (e.target && e.target.contains(i.root)) { i.destroy(); return false; }
        return true;
      });
    });
  })();
</script>

{% stylesheet %}
  .rtft {
    padding-block: clamp(40px, 6vw, 80px);
    background: #0a0d10;
    color: #fff;
    font-family: var(--font-body--family, Inter, system-ui, sans-serif);
  }

  .rtft *,
  .rtft *::before,
  .rtft *::after {
    box-sizing: border-box;
  }

  .rtft__wrap {
    max-width: 1100px;
    margin-inline: auto;
    padding-inline: clamp(16px, 4vw, 32px);
  }

  .rtft__eyebrow {
    margin: 0 0 10px;
    color: #d6ff3d;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .rtft__h {
    margin: 0;
    font-family: var(--rt-display, 'Barlow Condensed', 'Arial Narrow', Arial, sans-serif);
    font-size: clamp(34px, 5vw, 56px);
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
  }

  .rtft__lede {
    max-width: 62ch;
    margin: 14px 0 0;
    color: #b9c2c9;
    font-size: 17px;
    line-height: 1.5;
  }

  .rtft__tools {
    margin: 20px 0 0;
  }

  .rtft__toggle {
    min-height: 44px;
    padding: 8px 18px;
    border: 1px solid rgb(255 255 255 / 0.35);
    border-radius: 6px;
    background: transparent;
    color: #fff;
    font: inherit;
    font-size: 14px;
    cursor: pointer;
  }

  .rtft__toggle:hover {
    border-color: #fff;
  }

  .rtft button:focus-visible,
  .rtft a:focus-visible {
    outline: 3px solid #d6ff3d;
    outline-offset: 3px;
  }

  .rtft__methods {
    display: grid;
    gap: 14px;
    margin-top: 20px;
  }

  .rtft__m,
  .rtft__results,
  .rtft__care {
    padding: 20px;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: 14px;
    background: #10161c;
  }

  .rtft__tag {
    margin: 0 0 2px;
    color: #d6ff3d;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .rtft h3 {
    margin: 0 0 4px;
    font-family: var(--rt-display, 'Barlow Condensed', 'Arial Narrow', Arial, sans-serif);
    font-size: 26px;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .rtft svg {
    display: block;
    width: 100%;
    height: auto;
    margin: 12px 0;
    padding: 10px;
    border-radius: 10px;
    background: #06080b;
    font-family: var(--font-body--family, Inter, sans-serif);
  }

  .rtft ol,
  .rtft ul {
    margin: 0;
    padding-left: 20px;
    color: #e6ebee;
    font-size: 15px;
    line-height: 1.5;
  }

  .rtft li {
    margin: 6px 0;
  }

  .rtft__why {
    margin: 12px 0 0;
    color: #a3adb5;
    font-size: 14px;
    line-height: 1.5;
  }

  .rtft__results,
  .rtft__care {
    margin-top: 14px;
  }

  .rtft__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px 12px;
    margin-top: 12px;
  }

  .rtft__s {
    display: grid;
    gap: 4px;
    font-size: 13.5px;
    color: #a3adb5;
  }

  .rtft__s strong {
    color: #fff;
    font-size: 14.5px;
  }

  .rtft__pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
    margin-bottom: 6px;
  }

  .rtft__chip {
    position: relative;
    display: block;
    height: 72px;
    overflow: hidden;
    border-radius: 10px;
    background: #0a0c0f;
  }

  .rtft__chip i {
    position: absolute;
    inset: 14px 18px;
    border-radius: 6px;
    background: var(--c, var(--f));
  }

  .rtft__chip--flash i {
    background: var(--f);
  }

  .rtft__chip--retro i {
    background: #fffdf2;
    box-shadow: 0 0 22px 8px rgb(255 250 225 / 0.65);
  }

  .rtft__legend {
    display: flex;
    gap: 18px;
    margin: 12px 0 0;
    color: #a3adb5;
    font-size: 13px;
  }

  .rtft__care ul {
    margin-top: 8px;
  }

  .rtft__cta {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    margin-top: 18px;
    padding: 10px 24px;
    border-radius: 6px;
    background: #d6ff3d;
    color: #0a0d10;
    font-family: var(--rt-display, 'Barlow Condensed', 'Arial Narrow', Arial, sans-serif);
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
  }

  /* Static state: everything lit. Animation only runs while visible, not paused, and motion is allowed. */
  .rtft__pulse {
    opacity: 1;
  }

  .rtft.is-animating .rtft__pulse {
    animation: rtft-pulse 3s ease-in-out infinite;
  }

  .rtft.is-animating .rtft__pulse--late {
    animation-delay: 0.35s;
  }

  @keyframes rtft-pulse {
    0%,
    55%,
    100% {
      opacity: 0.12;
    }

    62%,
    80% {
      opacity: 1;
    }
  }

  @media (min-width: 760px) {
    .rtft__methods {
      grid-template-columns: 1fr 1fr;
    }

    .rtft__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rtft.is-animating .rtft__pulse {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RT Flash Test",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Test your own gear" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Is your gear retroreflective? Test it in 10 seconds." },
    { "type": "textarea", "id": "lede", "label": "Intro", "default": "In daylight, retroreflective material can look like plain grey fabric. These two simple tests show how a material responds to a light held close to your eyes or camera." },
    { "type": "text", "id": "cta_label", "label": "Button text", "default": "Shop by body zone" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "presets": [{ "name": "RT Flash Test" }]
}
{% endschema %}
