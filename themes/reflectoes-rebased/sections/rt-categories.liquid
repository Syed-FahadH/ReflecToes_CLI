<section class="rth rth-cats" aria-labelledby="rth-cats-{{ section.id }}">
  <div class="rth-wrap">
    <div class="rth-cats__head" data-reveal>
      <div>
        <p class="rth-eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="rth-h2" id="rth-cats-{{ section.id }}">{{ section.settings.heading }}</h2>
      </div>
      {%- assign all_link = section.settings.all_link | default: routes.all_products_collection_url -%}
      <a class="rth-cats__all" href="{{ all_link }}">{{ section.settings.all_label }}<span aria-hidden="true">&rarr;</span></a>
    </div>
  </div>
  <div class="rth-rail-wrap" data-reveal>
    <ul class="rth-rail" data-rth-rail>
      {%- for block in section.blocks -%}
        <li class="rth-rail__item{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
          <a class="rth-panel" href="{{ block.settings.link }}">
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 700 }}"
                srcset="{{ block.settings.image | image_url: width: 480 }} 480w, {{ block.settings.image | image_url: width: 700 }} 700w, {{ block.settings.image | image_url: width: 1000 }} 1000w"
                sizes="(min-width: 900px) 40vw, 74vw"
                width="700"
                height="700"
                alt=""
                loading="lazy"
                decoding="async"
              >
            {%- endif -%}
            <span class="rth-panel__num" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <span class="rth-panel__tag" aria-hidden="true">{{ block.settings.label }}</span>
            <span class="rth-panel__body">
              <span class="rth-panel__label">{{ block.settings.label }}</span>
              <span class="rth-panel__cta">Shop now<span aria-hidden="true">&rarr;</span></span>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
    <div class="rth-rail__bar" aria-hidden="true"><span data-rth-rail-bar></span></div>
  </div>
  <script>
    (function () {
      var rail = document.currentScript.parentNode.querySelector('[data-rth-rail]');
      if (!rail) return;
      var items = rail.querySelectorAll('.rth-rail__item');
      function activate(li) {
        items.forEach(function (i) { i.classList.toggle('is-active', i === li); });
      }
      items.forEach(function (li) {
        li.addEventListener('mouseenter', function () { activate(li); });
        li.addEventListener('focusin', function () { activate(li); });
      });
      var bar = rail.parentNode.querySelector('[data-rth-rail-bar]');
      if (bar) {
        var tick = false;
        rail.addEventListener('scroll', function () {
          if (tick) return;
          tick = true;
          requestAnimationFrame(function () {
            var max = rail.scrollWidth - rail.clientWidth;
            bar.style.transform = 'scaleX(' + (max > 0 ? 0.18 + 0.82 * (rail.scrollLeft / max) : 1) + ')';
            tick = false;
          });
        }, { passive: true });
      }
    })();
  </script>
</section>

{% schema %}
{
  "name": "RT Shop by gear",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Shop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by gear" },
    { "type": "text", "id": "all_label", "label": "Link text (right)", "default": "Browse all gear" },
    { "type": "url", "id": "all_link", "label": "Link (right)" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Jackets" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "RT Shop by gear" }]
}
{% endschema %}
