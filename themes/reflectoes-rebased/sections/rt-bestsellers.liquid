{%- assign list = section.settings.collection.products -%}

<section class="rth rth-best" aria-labelledby="rth-best-{{ section.id }}">
  <div class="rth-wrap">
    <div class="rth-best__head" data-reveal>
      <div>
        <p class="rth-eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="rth-h2" id="rth-best-{{ section.id }}">{{ section.settings.heading }}</h2>
      </div>
      <a class="rth-best__all" href="{{ section.settings.all_link | default: section.settings.collection.url }}">{{ section.settings.all_label }}</a>
    </div>
  </div>
  <ul class="rth-best__grid">
    {%- for product in list limit: section.settings.count -%}
      <li data-reveal style="--i: {{ forloop.index0 | modulo: 3 }}">
        <a class="rth-card" href="{{ product.url }}">
          <div class="rth-card__media">
            {%- if product.featured_image != blank -%}
              <img
                src="{{ product.featured_image | image_url: width: 480 }}"
                srcset="{{ product.featured_image | image_url: width: 320 }} 320w, {{ product.featured_image | image_url: width: 480 }} 480w, {{ product.featured_image | image_url: width: 640 }} 640w"
                sizes="(min-width: 900px) 30vw, 72vw"
                width="480"
                height="480"
                alt="{{ product.featured_image.alt | default: product.title | escape }}"
                loading="lazy"
                decoding="async"
              >
            {%- endif -%}
            {% render 'rt-rating', product: product %}
            {% render 'rt-flag', product: product %}
            {%- if product.compare_at_price > product.price -%}
              <span class="rth-card__badge">Save {{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price }}%</span>
            {%- endif -%}
          </div>
          <h3 class="rth-card__title">{{ product.title }}</h3>
          <p class="rth-card__price">
            {%- if product.compare_at_price > product.price -%}
              <span>{{ product.price | money }}</span>
              <s>{{ product.compare_at_price | money }}</s>
            {%- elsif product.price_varies -%}
              <span>From {{ product.price | money }}</span>
            {%- else -%}
              <span>{{ product.price | money }}</span>
            {%- endif -%}
          </p>
        </a>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "RT Bestsellers",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Bestsellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What riders and runners buy" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "count", "label": "Products to show", "min": 3, "max": 9, "step": 3, "default": 6 },
    { "type": "text", "id": "all_label", "label": "View all text", "default": "Shop all gear" },
    { "type": "url", "id": "all_link", "label": "View all link" }
  ],
  "presets": [{ "name": "RT Bestsellers" }]
}
{% endschema %}
