<section class="rth rth-rev" aria-labelledby="rth-rev-{{ section.id }}">
  <div class="rth-wrap">
    <h2 class="rth-h2" data-reveal id="rth-rev-{{ section.id }}">{{ section.settings.heading }}</h2>
    <ul class="rth-rev__grid">
      {%- for block in section.blocks -%}
        <li data-reveal style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <figure class="rth-quote">
            <div class="rth-quote__stars" role="img" aria-label="{{ block.settings.stars }} out of 5 stars">
              {%- for i in (1..5) -%}{%- if i <= block.settings.stars -%}&#9733;{%- else -%}&#9734;{%- endif -%}{%- endfor -%}
            </div>
            <blockquote class="rth-quote__text">{{ block.settings.text }}</blockquote>
            <figcaption class="rth-quote__who">{{ block.settings.name }}</figcaption>
          </figure>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "RT Reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What Our Customers Say" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "text", "label": "Review text" },
        { "type": "text", "id": "name", "label": "Name" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "RT Reviews" }]
}
{% endschema %}
