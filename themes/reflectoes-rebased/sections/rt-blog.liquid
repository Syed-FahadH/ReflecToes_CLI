{%- assign posts = section.settings.blog.articles -%}

{%- if posts.size > 0 -%}
  <section class="rth rth-blog" aria-labelledby="rth-blog-{{ section.id }}">
    <div class="rth-wrap">
      <div class="rth-blog__head" data-reveal>
        <div>
          <p class="rth-eyebrow">{{ section.settings.eyebrow }}</p>
          <h2 class="rth-h2" id="rth-blog-{{ section.id }}">{{ section.settings.heading }}</h2>
        </div>
        <a class="rth-best__all" href="{{ section.settings.blog.url }}">{{ section.settings.all_label }}</a>
      </div>

      <ul class="rth-blog__grid">
        {%- for article in posts limit: section.settings.count -%}
          <li data-reveal style="--i: {{ forloop.index0 }}">
            <a class="rth-post" href="{{ article.url }}">
              <div class="rth-post__media">
                {%- if article.image != blank -%}
                  <img
                    src="{{ article.image | image_url: width: 600 }}"
                    srcset="{{ article.image | image_url: width: 400 }} 400w, {{ article.image | image_url: width: 600 }} 600w, {{ article.image | image_url: width: 900 }} 900w"
                    sizes="(min-width: 900px) 30vw, 92vw"
                    width="600"
                    height="375"
                    alt="{{ article.image.alt | default: article.title | escape }}"
                    loading="lazy"
                    decoding="async"
                  >
                {%- endif -%}
              </div>
              <div class="rth-post__body">
                <p class="rth-post__meta">{{ article.published_at | date: '%b %-d, %Y' }}</p>
                <h3 class="rth-post__title">{{ article.title }}</h3>
                <p class="rth-post__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
                <span class="rth-post__more">{{ section.settings.read_label }}</span>
              </div>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "RT Blog",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "From the blog" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Ride and run smarter" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "count", "label": "Posts to show", "min": 3, "max": 6, "step": 1, "default": 3 },
    { "type": "text", "id": "all_label", "label": "View all text", "default": "All articles" },
    { "type": "text", "id": "read_label", "label": "Read link text", "default": "Read" }
  ],
  "presets": [{ "name": "RT Blog" }]
}
{% endschema %}
