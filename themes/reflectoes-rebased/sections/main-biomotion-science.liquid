<script>
  (function () {
    var canvas = document.getElementById('bm-joint-canvas');
    var distLabel = document.getElementById('bm-distance-label');
    var btns = document.querySelectorAll('#bm-joint-figure .bm-mode-btn');
    var modeData = {
      none: { ft: '~55 ft', cls: 'bm-mode-none' },
      vest: { ft: '~120 ft', cls: 'bm-mode-vest' },
      bio:  { ft: '~410 ft', cls: 'bm-mode-bio' }
    };
    function setMode(mode) {
      if (!canvas) return;
      canvas.classList.remove('bm-mode-none', 'bm-mode-vest', 'bm-mode-bio');
      canvas.classList.add(modeData[mode].cls);
      if (distLabel) distLabel.innerHTML = 'Driver detects: <b>' + modeData[mode].ft + '</b>';
      btns.forEach(function (b) {
        b.setAttribute('aria-pressed', b.getAttribute('data-mode') === mode ? 'true' : 'false');
      });
    }
    btns.forEach(function (b) {
      b.addEventListener('click', function () { setMode(b.getAttribute('data-mode')); });
    });

    var chart = document.getElementById('bm-chart');
    var bars = chart ? chart.querySelectorAll('.bm-chart-bar') : [];
    var markers = document.querySelectorAll('.bm-scene-marker');
    var animated = false;
    function maybeAnimate() {
      if (animated || !chart) return;
      var rect = chart.getBoundingClientRect();
      if (rect.top < (window.innerHeight || document.documentElement.clientHeight) * 0.85) {
        animated = true;
        bars.forEach(function (b) { b.classList.add('is-loaded'); });
        markers.forEach(function (m) { m.classList.add('is-loaded'); });
      }
    }
    window.addEventListener('scroll', maybeAnimate, { passive: true });
    window.addEventListener('load', maybeAnimate);
    maybeAnimate();
  })();
</script>

