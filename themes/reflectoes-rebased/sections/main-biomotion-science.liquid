          <line class="bm-ray bm-ray-out-diffuse bm-ray-anim-out" x1="80" y1="50" x2="40" y2="20"/>
          <line class="bm-ray bm-ray-out-diffuse bm-ray-anim-out" x1="80" y1="50" x2="40" y2="80"/>
