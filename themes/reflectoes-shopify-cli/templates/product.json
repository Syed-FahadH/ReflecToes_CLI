    "custom_liquid_4qGExE": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<style>\n  .slideshow-wrapper {\n    position: relative;\n    width: 100%;\n    max-width: 100%;\n    overflow: hidden;\n  }\n\n  .slideshow-image {\n    width: 100%;\n    height: auto;\n    display: none;\n  }\n\n  .slideshow-image.active {\n    display: block;\n  }\n\n  @media (max-width: 768px) {\n    .desktop-img {\n      display: none !important;\n    }\n\n    .mobile-img {\n      display: block;\n      width: 100%;\n      aspect-ratio: 1.33 / 1;\n      object-fit: contain;\n      background-color: #f9f9f9;\n    }\n  }\n\n  @media (min-width: 769px) {\n    .mobile-img {\n      display: none !important;\n    }\n\n    .desktop-img {\n      display: block;\n    }\n  }\n</style>\n\n<div class=\"slideshow-wrapper\">\n  <!-- Desktop Images -->\n  <img loading=\"lazy\" decoding=\"async\" src=\"https://cdn.shopify.com/s/files/1/0056/6847/0855/files/Socks_1.jpg?v=1750505272\" class=\"slideshow-image active desktop-img\" alt=\"Jacket 1\">\n  <img loading=\"lazy\" decoding=\"async\" src=\"https://cdn.shopify.com/s/files/1/0056/6847/0855/files/Socks_2.jpg?v=1750505271\" class=\"slideshow-image desktop-img\" alt=\"Jacket 2\">\n  <img loading=\"lazy\" decoding=\"async\" src=\"https://cdn.shopify.com/s/files/1/0056/6847/0855/files/Socks_3.jpg?v=1750505272\" class=\"slideshow-image desktop-img\" alt=\"Size Chart\">\n\n  <!-- Mobile Images -->\n  <img loading=\"lazy\" decoding=\"async\" src=\"https://cdn.shopify.com/s/files/1/0056/6847/0855/files/Socks_M1.jpg?v=1750505271\" class=\"slideshow-image mobile-img\" alt=\"Jacket Mob 1\">\n  <img loading=\"lazy\" decoding=\"async\" src=\"https://cdn.shopify.com/s/files/1/0056/6847/0855/files/Socks_M2.jpg?v=1750505271\" class=\"slideshow-image mobile-img\" alt=\"Jacket Mob 2\">\n  <img loading=\"lazy\" decoding=\"async\" src=\"https://cdn.shopify.com/s/files/1/0056/6847/0855/files/Socks_M3.jpg?v=1750505271\" class=\"slideshow-image mobile-img\" alt=\"Size Chart Mob\">\n</div>\n\n<script>\n  let currentIndex = 0;\n\n  const desktopImages = document.querySelectorAll('.desktop-img');\n  const mobileImages = document.querySelectorAll('.mobile-img');\n\n  function isMobile() {\n    return window.innerWidth <= 768;\n  }\n\n  function updateVisibility() {\n    const slides = isMobile() ? mobileImages : desktopImages;\n    [...desktopImages, ...mobileImages].forEach(img => img.classList.remove('active'));\n    if (slides[currentIndex]) {\n      slides[currentIndex].classList.add('active');\n    }\n  }\n\n  window.addEventListener('resize', updateVisibility);\n  document.addEventListener('DOMContentLoaded', updateVisibility);\n</script>",
        "background_color": "{{ settings.color_palette.background }}",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
