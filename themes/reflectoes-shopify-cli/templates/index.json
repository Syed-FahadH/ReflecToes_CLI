    "custom_liquid_EgLMVr": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n  .hero-inline {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    width: 100%;\n    background: #000;\n    color: #fff;\n    padding: 2rem;\n    gap: 2rem;\n    flex-wrap: nowrap;\n    box-sizing: border-box;\n  }\n  .hero-text-inline {\n    flex: 1;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    gap: 2rem;\n    font-family: 'Manrope', sans-serif;\n    padding-left: 2rem;\n  }\n  .hero-text-inline h2 {\n    font-family: 'Aboreto', cursive;\n    font-size: 2rem;\n    margin: 0;\n    color: #fff;\n  }\n  .hero-text-inline p {\n    font-size: 1rem;\n    line-height: 1.6;\n    margin: 0;\n    color: #fff;\n  }\n  .hero-text-inline a {\n    padding: 12px;\n    min-width: 220px;\n    text-align: center;\n    font-size: 1rem;\n    background: #ADFF2F;\n    color: #000;\n    text-decoration: none;\n    font-weight: bold;\n    border-radius: 4px;\n    width: fit-content;\n  }\n  .hero-image-inline {\n    flex: 1;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n  }\n  .hero-image-inline img {\n    width: 100%;\n    max-width: 600px;\n    height: auto;\n    object-fit: contain;\n  }\n  @media (max-width: 768px) {\n    .hero-inline {\n      flex-direction: column;\n      padding: 1rem;\n      text-align: center;\n    }\n    .hero-text-inline {\n      padding-left: 0;\n      align-items: center;\n    }\n    .hero-text-inline h2 {\n      font-size: 2rem;\n    }\n  }\n</style>\n<div class=\"hero-inline\">\n  <div class=\"hero-text-inline\">\n    <h2>Designed to be seen.<br>Built around how motion is recognized in low light.</h2>\n    <p>Our reflective placement is research-informed and biomotion-based, positioned on moving joints rather than added as a single logo — reflecting how the human eye picks up recognizable motion after dark.</p>\n    <a href=\"/collections/all\">Shop Reflective Jersey</a>\n  </div>\n  <div class=\"hero-image-inline\">\n    <img\n      src=\"https://cdn.shopify.com/s/files/1/0056/6847/0855/files/Comp.webp?width=600\"\n      srcset=\"\n        https://cdn.shopify.com/s/files/1/0056/6847/0855/files/Comp.webp?width=400 400w,\n        https://cdn.shopify.com/s/files/1/0056/6847/0855/files/Comp.webp?width=600 600w,\n        https://cdn.shopify.com/s/files/1/0056/6847/0855/files/Comp.webp?width=750 750w\"\n      sizes=\"(max-width: 768px) 90vw, 600px\"\n      alt=\"Reflective vest for night running and cycling\"\n      width=\"600\"\n      height=\"600\"\n      loading=\"lazy\"\n      decoding=\"async\">\n  </div>\n</div>",
