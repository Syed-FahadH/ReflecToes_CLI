{
  "sections": {
    "custom_liquid_YGP47a": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "{%- comment -%}\n  ============================================================\n  REFLECTOES — DAY / NIGHT EDITORIAL HERO  (v6.5 — reduced-motion fix)\n  Paste into: Shopify → Online Store → Themes → Customize →\n  Add section → Custom Liquid\n\n  WHAT CHANGED FROM v6.4\n  The prefers-reduced-motion block was killing the Day/Night toggle's\n  \"is-inviting\" nudge animation (rt-ring / rt-tease / rt-wake) entirely\n  on any device reporting reduced motion (e.g. Windows \"Animation\n  effects\" off). That's why it worked on mobile but not on desktop\n  in Brave/Chrome on Windows.\n\n  Fix: the toggle's invite nudge is small, slow, and is the only\n  affordance telling people the pill is interactive — so it's kept\n  even under reduced-motion. Only the thumb-slide's own transition\n  duration and the three explicit animation:none rules for\n  .rt-toggle.is-inviting were removed; the panel fade-in and beam\n  stay calmed as before.\n  ============================================================\n{%- endcomment -%}\n\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;800&display=swap\" rel=\"stylesheet\">\n\n<section class=\"rt-hero\" id=\"rt-hero\" data-mode=\"day\" aria-label=\"ReflecToes reflective performance wear\">\n\n  <div class=\"rt-hero__beam\" aria-hidden=\"true\"></div>\n\n  <div class=\"rt-grid\" id=\"rt-grid\">\n\n    <div class=\"rt-brand\" id=\"rt-brand\">\n      <div class=\"rt-brand__top\">\n        <span class=\"rt-brand__eyebrow\">Visibility in Motion</span>\n      </div>\n\n      <div class=\"rt-brand__mid\">\n        <img class=\"rt-brand__logo\" id=\"rt-logo\" alt=\"ReflecToes\"\n             src=\"https://cdn.shopify.com/s/files/1/0056/6847/0855/files/Reflectoes_Logo_White.png?v=1786649755&width=400&format=webp\">\n        <h1 class=\"rt-brand__title\">Reflective Running &amp; Cycling Gear</h1>\n        <p class=\"rt-brand__copy\">Fluorescent by day. Retroreflective by night.</p>\n      </div>\n\n      <div class=\"rt-brand__bottom\">\n        <div class=\"rt-toggle\" role=\"group\" aria-label=\"Preview in day or night light\">\n          <span class=\"rt-toggle__thumb\" aria-hidden=\"true\"></span>\n          <button type=\"button\" class=\"rt-toggle__btn is-active\" data-mode=\"day\" aria-pressed=\"true\">\n            <svg viewBox=\"0 0 24 24\" width=\"15\" height=\"15\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"4.2\"/><path d=\"M12 2v2.4M12 19.6V22M4.2 4.2l1.7 1.7M18.1 18.1l1.7 1.7M2 12h2.4M19.6 12H22M4.2 19.8l1.7-1.7M18.1 5.9l1.7-1.7\"/></svg>\n            Day\n          </button>\n          <button type=\"button\" class=\"rt-toggle__btn\" data-mode=\"night\" aria-pressed=\"false\">\n            <svg viewBox=\"0 0 24 24\" width=\"15\" height=\"15\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 14.2A8.2 8.2 0 1 1 9.8 4a6.6 6.6 0 0 0 10.2 10.2z\"/></svg>\n            Night\n          </button>\n        </div>\n        <p class=\"rt-toggle__hint\" id=\"rt-hint\">See the reflection come alive</p>\n\n        <div class=\"rt-cta-group\">\n          <a href=\"/pages/daylight-kit\" class=\"rt-cta\" id=\"rt-cta\">\n            <span class=\"rt-cta__label\" id=\"rt-cta-label\">Build Your Daylight Kit</span>\n            <svg viewBox=\"0 0 24 24\" width=\"13\" height=\"13\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" aria-hidden=\"true\"><path d=\"M5 12h14M13 6l6 6-6 6\"/></svg>\n          </a>\n          <a href=\"/collections/all\" class=\"rt-cta-secondary\">Shop All Gear</a>\n        </div>\n      </div>\n    </div>\n\n    <!-- Product panels injected here -->\n  </div>\n</section>\n\n<style>\n#rt-hero{\n  --rt-bg:#f2f0ed;\n  --rt-panel:#fbfaf8;\n  --rt-brand-bg:#16130f;\n  --rt-brand-ink:#fbfaf8;\n  --rt-ink:#16130f;\n  --rt-ink-soft:rgba(22,19,15,.52);\n  --rt-hair:rgba(22,19,15,.12);\n  --rt-accent:#a16207;\n\n  --rt-ease:cubic-bezier(.62,.03,.16,1);\n  --rt-dur:380ms;\n  --rt-img-dur:300ms;\n  --rt-gap:0px;\n\n  position:relative;\n  width:100%;\n  height:clamp(600px, 84svh, 860px);\n  background:var(--rt-hair);\n  color:var(--rt-ink);\n  overflow:hidden;\n  isolation:isolate;\n  font-family:'Inter', ui-sans-serif, -apple-system, \"Helvetica Neue\", Arial, sans-serif;\n  -webkit-font-smoothing:antialiased;\n  transition:background var(--rt-dur) var(--rt-ease);\n}\n#rt-hero[data-mode=\"night\"]{\n  --rt-bg:#08080a;\n  --rt-panel:#0c0c0f;\n  --rt-brand-bg:#000;\n  --rt-brand-ink:#fff;\n  --rt-ink:#f4f3f1;\n  --rt-ink-soft:rgba(244,243,241,.5);\n  --rt-hair:rgba(255,255,255,.09);\n}\n\n.rt-grid{\n  position:absolute; inset:0;\n  display:grid;\n  gap:var(--rt-gap);\n  grid-template-columns:repeat(12,1fr);\n  /* Gives the brand column noticeably more room than v6.3 so its\n     content can breathe, while the product row keeps a healthy\n     minimum height. */\n  grid-template-rows:1.3fr minmax(170px, .7fr);\n  background:var(--rt-hair);\n  transition:background var(--rt-dur) var(--rt-ease);\n}\n\n.rt-panel{\n  position:relative;\n  overflow:hidden;\n  min-height:0;\n  background:var(--rt-panel);\n  transition:background var(--rt-dur) var(--rt-ease);\n  opacity:0;\n  animation:rt-in .9s var(--rt-ease) forwards;\n}\n@keyframes rt-in{from{opacity:0;transform:scale(.995);}to{opacity:1;transform:none;}}\n\n.rt-panel__img{\n  position:absolute; inset:0;\n  width:100%; height:100%;\n  object-fit:cover;\n  object-position:50% 20%;\n  display:block;\n  transition:opacity var(--rt-img-dur) var(--rt-ease),\n             filter var(--rt-img-dur) var(--rt-ease),\n             transform 1.1s var(--rt-ease);\n}\n.rt-panel__img--night{opacity:0;}\n#rt-hero[data-mode=\"day\"] .rt-panel__img--day{filter:saturate(.94) contrast(1.02);}\n#rt-hero[data-mode=\"night\"] .rt-panel__img--day{opacity:0;}\n#rt-hero[data-mode=\"night\"] .rt-panel__img--night{opacity:1;}\n\n#rt-hero[data-mode=\"night\"] .rt-panel[data-fallback=\"1\"] .rt-panel__img--day{\n  opacity:1;\n  filter:grayscale(.4) brightness(.32) contrast(2.4) saturate(.5);\n}\n\n.rt-panel__tone{\n  position:absolute; inset:0; z-index:1;\n  pointer-events:none;\n  background:#efece7;\n  mix-blend-mode:multiply;\n  opacity:.16;\n  transition:opacity var(--rt-img-dur) var(--rt-ease), background var(--rt-img-dur) var(--rt-ease);\n}\n#rt-hero[data-mode=\"night\"] .rt-panel__tone{\n  background:#0a0d14;\n  mix-blend-mode:normal;\n  opacity:.28;\n}\n\n.rt-panel:hover .rt-panel__img{transform:scale(1.02);}\n\n.rt-panel::before{\n  content:\"\";\n  position:absolute; left:0; right:0; bottom:0;\n  height:38%;\n  z-index:2; pointer-events:none;\n  opacity:0;\n  background:linear-gradient(to top, rgba(0,0,0,.55), rgba(0,0,0,0));\n  transition:opacity .45s var(--rt-ease);\n}\n.rt-panel:hover::before,\n.rt-panel:focus-within::before{opacity:1;}\n\n.rt-panel__cap{\n  position:absolute; left:0; right:0; bottom:clamp(14px,1.4vw,22px);\n  z-index:3; margin:0;\n  text-align:center;\n  font-size:9.5px; letter-spacing:.22em; text-transform:uppercase;\n  color:#fff;\n  opacity:0;\n  transform:translateY(6px);\n  transition:opacity .45s var(--rt-ease), transform .45s var(--rt-ease);\n}\n.rt-panel:hover .rt-panel__cap,\n.rt-panel:focus-within .rt-panel__cap{opacity:1; transform:none;}\n\n.rt-panel__link{position:absolute; inset:0; z-index:2;}\n.rt-panel__link:focus-visible{outline:2px solid var(--rt-accent); outline-offset:-5px;}\n\n.rt-brand{\n  position:relative;\n  z-index:4;\n  grid-area:1 / 4 / 2 / 10;\n  min-height:0;\n  background:var(--rt-brand-bg);\n  color:var(--rt-brand-ink);\n  display:flex;\n  flex-direction:column;\n  justify-content:center;\n  align-items:center;\n  gap:clamp(28px,3.2vw,42px);\n  text-align:center;\n  padding:clamp(28px,3.6vw,48px) clamp(20px,2.4vw,36px);\n  /* Safety net only — becomes scrollable (scrollbar hidden) rather\n     than clipping, on the rare screen where content still doesn't\n     fully fit. Invisible in normal use. */\n  overflow-y:auto;\n  -ms-overflow-style:none;\n  scrollbar-width:none;\n  transition:background var(--rt-dur) var(--rt-ease), color var(--rt-dur) var(--rt-ease);\n}\n.rt-brand::-webkit-scrollbar{display:none;}\n\n.rt-brand__eyebrow{\n  font-size:10px; letter-spacing:.34em; text-transform:uppercase;\n  opacity:.55;\n}\n.rt-brand__mid{\n  width:100%;\n  display:flex;\n  flex-direction:column;\n  align-items:center;\n  gap:clamp(20px,2.4vw,30px)\n}\n\n.rt-brand__logo{\n  display:block;\n  width:auto;\n  height:clamp(22px,2vw,30px);\n  max-width:60%;\n  object-fit:contain;\n  opacity:.9;\n  transition:filter var(--rt-dur) var(--rt-ease);\n}\n#rt-hero[data-mode=\"night\"] .rt-brand__logo{\n  filter:drop-shadow(0 0 1px rgba(255,255,255,.7))\n         drop-shadow(0 0 18px rgba(214,226,236,.3));\n}\n\n.rt-brand__title{\n  margin:0;\n  font-family:'Inter', sans-serif;\n  font-weight:800;\n  font-size:clamp(22px,2.6vw,34px);\n  line-height:1.08;\n  letter-spacing:-.015em;\n  max-width:25ch;\n  color:var(--rt-brand-ink);\n  transition:color var(--rt-dur) var(--rt-ease);\n}\n\n.rt-brand__copy{\n  margin:0;\n  max-width:40ch;\n  font-size:clamp(14px,1vw,15px);\n  line-height:1.5;\n  letter-spacing:.005em;\n  color:var(--rt-brand-ink);\n  opacity:.72;\n}\n\n.rt-brand__bottom{\n  display:flex;\n  flex-direction:column;\n  align-items:center;\n  gap:clamp(18px,1.6vw,26px);\n  width:100%;\n}\n\n.rt-toggle{\n  position:relative;\n  display:flex;\n  width:fit-content;\n  padding:4px;\n  border:1px solid rgba(255,255,255,.3);\n  border-radius:999px;\n  background:rgba(255,255,255,.05);\n}\n.rt-toggle__thumb{\n  position:absolute; top:4px; left:4px;\n  width:calc(50% - 4px); height:calc(100% - 8px);\n  border-radius:999px;\n  background:var(--rt-brand-ink);\n  transition:transform 420ms var(--rt-ease), background var(--rt-dur) var(--rt-ease);\n}\n#rt-hero[data-mode=\"night\"] .rt-toggle__thumb{transform:translateX(100%);}\n.rt-toggle__btn{\n  position:relative; z-index:1;\n  display:inline-flex; align-items:center; justify-content:center; gap:8px;\n  min-width:112px;\n  padding:11px 24px;\n  border:0; background:none; cursor:pointer;\n  font:inherit;\n  font-size:11px; font-weight:600;\n  letter-spacing:.18em; text-transform:uppercase;\n  color:rgba(255,255,255,.6);\n  transition:color 300ms var(--rt-ease);\n}\n.rt-toggle__btn svg{flex:none;}\n\n.rt-toggle__hint{\n  margin:0;\n  font-size:9px; letter-spacing:.26em; text-transform:uppercase;\n  color:rgba(255,255,255,.5);\n  transition:opacity .4s var(--rt-ease);\n}\n.rt-toggle__hint[hidden]{display:none;}\n.rt-toggle__btn.is-active{color:var(--rt-brand-bg);}\n.rt-toggle__btn:focus-visible{outline:2px solid #fff; outline-offset:2px; border-radius:999px;}\n\n.rt-toggle.is-inviting{\n  border-color:rgba(255,255,255,.4);\n  animation:rt-ring 3.2s var(--rt-ease) infinite;\n}\n.rt-toggle.is-inviting .rt-toggle__thumb{\n  animation:rt-tease 3.2s var(--rt-ease) infinite;\n}\n.rt-toggle.is-inviting .rt-toggle__btn[data-mode=\"night\"]{\n  animation:rt-wake 3.2s var(--rt-ease) infinite;\n}\n@keyframes rt-ring{\n  0%, 58%, 100%{box-shadow:0 0 0 0 rgba(255,255,255,0);}\n  14%          {box-shadow:0 0 0 6px rgba(255,255,255,.18);}\n  38%          {box-shadow:0 0 0 18px rgba(255,255,255,0);}\n}\n@keyframes rt-tease{\n  0%, 8%, 46%, 100%{transform:translateX(0);}\n  22%, 32%         {transform:translateX(34%);}\n}\n@keyframes rt-wake{\n  0%, 8%, 52%, 100%{color:rgba(255,255,255,.6);}\n  24%, 34%         {color:#fff;}\n}\n\n.rt-cta-group{\n  display:flex;\n  flex-direction:column;\n  align-items:center;\n  gap:14px;\n}\n\n.rt-cta{\n  display:inline-flex; align-items:center; gap:8px;\n  padding:12px 24px;\n  border-radius:999px;\n  background:var(--rt-brand-ink);\n  color:var(--rt-brand-bg);\n  font-size:10px; font-weight:600;\n  letter-spacing:.16em; text-transform:uppercase;\n  text-decoration:none;\n  transition:opacity .25s var(--rt-ease), gap .25s var(--rt-ease),\n             background var(--rt-dur) var(--rt-ease), color var(--rt-dur) var(--rt-ease);\n}\n.rt-cta:hover{opacity:.85; gap:12px;}\n.rt-cta:focus-visible{outline:2px solid #fff; outline-offset:2px;}\n.rt-cta svg{flex:none;}\n\n.rt-cta-secondary{\n  font-size:10px; font-weight:500;\n  letter-spacing:.2em; text-transform:uppercase;\n  color:var(--rt-brand-ink);\n  opacity:.65;\n  text-decoration:none;\n  transition:opacity .25s var(--rt-ease), color var(--rt-dur) var(--rt-ease);\n}\n.rt-cta-secondary:hover{opacity:.9;}\n.rt-cta-secondary:focus-visible{outline:2px solid #fff; outline-offset:2px;}\n\n.rt-hero__beam{\n  position:absolute; inset:-20%;\n  z-index:1; pointer-events:none; opacity:0;\n  background:radial-gradient(34% 50% at var(--rt-mx,50%) var(--rt-my,45%),\n    rgba(255,255,255,.09) 0%, rgba(255,255,255,.03) 40%, transparent 70%);\n  mix-blend-mode:screen;\n  transition:opacity var(--rt-dur) var(--rt-ease);\n}\n#rt-hero[data-mode=\"night\"] .rt-hero__beam{opacity:1;}\n\n@media (max-width:1180px){\n  .rt-brand{grid-area:1 / 4 / 2 / 10;}\n  .rt-brand__title{font-size:clamp(19px,3vw,30px);}\n}\n\n/* Extra compaction only for short (laptop-height) windows — still\n   comfortable, just tighter than the default desktop spacing. */\n@media (min-width:901px) and (max-height:760px){\n  .rt-brand{gap:16px; padding:18px clamp(20px,2.4vw,36px);}\n  .rt-brand__mid{gap:14px;}\n  .rt-brand__bottom{gap:12px;}\n  .rt-brand__logo{height:20px;}\n  .rt-brand__eyebrow{font-size:8.5px;}\n  .rt-brand__title{font-size:clamp(17px,2.1vw,26px);}\n  .rt-brand__copy{font-size:13px;}\n  .rt-toggle__btn{padding:9px 18px;}\n  .rt-cta{padding:9px 20px;}\n}\n\n@media (max-width:900px){\n  #rt-hero{height:auto; min-height:clamp(760px,104svh,1060px);}\n  .rt-grid{\n    position:relative;\n    grid-template-columns:1fr 1fr;\n    grid-template-rows:auto 1fr 1fr 1fr;\n    min-height:inherit;\n  }\n  .rt-brand{\n    grid-area:1 / 1 / 2 / 3;\n    padding:clamp(24px,4vw,36px) 24px clamp(20px,3vw,28px);\n    gap:16px;\n    overflow-y:visible;\n  }\n  .rt-brand__title{font-size:clamp(24px,6vw,34px);}\n  .rt-brand__copy{max-width:32ch;}\n}\n\n@media (max-width:600px){\n  #rt-hero{min-height:clamp(740px,108svh,1020px);}\n  .rt-brand{padding:22px 18px 20px; gap:14px;}\n  .rt-brand__eyebrow{font-size:8.5px; letter-spacing:.26em;}\n  .rt-brand__title{font-size:clamp(22px,7vw,30px); max-width:16ch;}\n  .rt-brand__copy{font-size:13px; max-width:30ch;}\n  .rt-brand__bottom{gap:12px;}\n  .rt-toggle{width:100%; max-width:250px;}\n  .rt-toggle__btn{flex:1 1 50%; min-width:0; padding:12px 8px;}\n  .rt-cta{width:100%; max-width:280px; justify-content:center;}\n  .rt-panel__cap{font-size:8.5px; letter-spacing:.16em; bottom:11px;}\n  .rt-panel:hover .rt-panel__img{transform:none;}\n}\n\n@media (prefers-reduced-motion:reduce){\n  #rt-hero{--rt-dur:1ms; --rt-img-dur:1ms;}\n  .rt-panel{animation:none; opacity:1;}\n  .rt-panel__img,.rt-hero__beam{transition-duration:1ms;}\n  /* Keep the toggle's invite nudge — it's the only affordance telling\n     people the pill is interactive, and it's small/slow enough to be safe. */\n  .rt-toggle.is-inviting{border-color:rgba(255,255,255,.4);}\n}\n</style>\n\n<script>\n(function(){\n  var hero = document.getElementById('rt-hero');\n  if(!hero || hero.dataset.rtInit) return;\n  hero.dataset.rtInit = '1';\n\n  var RT_LOGO = 'https://cdn.shopify.com/s/files/1/0056/6847/0855/files/Reflectoes_Logo_White.png?v=1786649755&width=400&format=webp';\n\n  var RT_CTA = {\n    day:   { label:'Build Your Daylight Kit', href:'/pages/daylight-kit' },\n    night: { label:'Build Your Night Kit',    href:'/pages/night-kit' }\n  };\n\n  /* Every day/night URL now carries &width=1600&format=webp so Shopify's\n     CDN serves a resized, compressed version instead of the original\n     full-res file. This is the single biggest weight reduction here. */\n  var RT_PANELS = [\n    { label:'Jackets', href:'/collections/jackets',\n      day:'https://cdn.shopify.com/s/files/1/0056/6847/0855/files/Jacket_Day_1.png?v=1786704820&width=1600&format=webp',\n      night:'https://cdn.shopify.com/s/files/1/0056/6847/0855/files/Jacket_Night_V2.jpg?v=1786820775&width=1600&format=webp',\n      pos:'50% 12%',\n      area:'1 / 1 / 2 / 4',    mobile:'2 / 1 / 3 / 2' },\n\n    { label:'Vests', href:'/collections/vests',\n      day:'https://cdn.shopify.com/s/files/1/0056/6847/0855/files/Vest_Day_1.png?v=1786704820&width=1600&format=webp',\n      night:'https://cdn.shopify.com/s/files/1/0056/6847/0855/files/Gemini_Generated_Image_ara59vara59vara5.jpg?v=1787118168&width=1600&format=webp',\n      pos:'50% 12%',\n      area:'1 / 10 / 2 / 13',  mobile:'2 / 2 / 3 / 3' },\n\n    { label:'Gloves', href:'/collections/gloves',\n      day:'https://cdn.shopify.com/s/files/1/0056/6847/0855/files/Running_Winter_Day_Site.png?v=1787222632&width=1200&format=webp',\n      night:'https://cdn.shopify.com/s/files/1/0056/6847/0855/files/Running_Winter_Night_Site.png?v=1787222632&width=1200&format=webp',\n      pos:'50% 40%',\n      area:'2 / 1 / 3 / 4',    mobile:'3 / 1 / 4 / 2' },\n\n    { label:'Winter Gloves', href:'/products/reflectoes-reflective-winter-gloves',\n      day:'https://cdn.shopify.com/s/files/1/0056/6847/0855/files/Winter_G1_Site_Day.png?v=1787224046&width=1200&format=webp',\n      night:'https://cdn.shopify.com/s/files/1/0056/6847/0855/files/Winter_G1_Site_Night_ded911d6-9ebe-438a-b0cf-7a7e75fa67f8.png?v=1787224045&width=1200&format=webp',\n      pos:'50% 40%',\n      area:'2 / 10 / 3 / 13',  mobile:'3 / 2 / 4 / 3' },\n\n    { label:'Jerseys', href:'/collections/jerseys',\n      day:'https://cdn.shopify.com/s/files/1/0056/6847/0855/files/Jersey_HZ_FS_Day_1.png?v=1786704820&width=1200&format=webp',\n      night:'https://cdn.shopify.com/s/files/1/0056/6847/0855/files/Jersey_Night_V2.jpg?v=1786820775&width=1200&format=webp',\n      pos:'50% 18%',\n      area:'2 / 4 / 3 / 7',    mobile:'4 / 1 / 5 / 2' },\n\n    { label:'Socks', href:'/collections/socks',\n      day:'https://cdn.shopify.com/s/files/1/0056/6847/0855/files/r-black-socks-ambient.png?v=1786647932&width=1200&format=webp',\n      night:'https://cdn.shopify.com/s/files/1/0056/6847/0855/files/Socks_night.png?v=1786704821&width=1200&format=webp',\n      pos:'50% 50%',\n      area:'2 / 7 / 3 / 10',   mobile:'4 / 2 / 5 / 3' }\n  ];\n\n  function placeholder(label, i){\n    var tones = ['#e9e7e3','#e2dfda','#eeece8','#dcd9d4'];\n    var svg = '<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"800\" height=\"1000\">'\n      + '<rect width=\"800\" height=\"1000\" fill=\"'+tones[i % tones.length]+'\"/>'\n      + '<text x=\"400\" y=\"520\" text-anchor=\"middle\" font-family=\"Helvetica,Arial\" '\n      + 'font-size=\"22\" letter-spacing=\"5\" fill=\"#8b8882\">'+label.toUpperCase()+'</text></svg>';\n    return 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg);\n  }\n\n  var logoEl = document.getElementById('rt-logo');\n  if(logoEl){\n    if(RT_LOGO){\n      logoEl.src = RT_LOGO;\n      logoEl.addEventListener('error', function(){ logoEl.hidden = true; });\n    } else {\n      logoEl.hidden = true;\n    }\n  }\n\n  var grid  = document.getElementById('rt-grid');\n  var brand = document.getElementById('rt-brand');\n  var css   = [];\n  var frag  = document.createDocumentFragment();\n\n  RT_PANELS.forEach(function(p, i){\n    var id = 'rt-p-' + i;\n    var hasNight = !!p.night;\n\n    var el = document.createElement('article');\n    el.className = 'rt-panel';\n    el.id = id;\n    el.style.animationDelay = (80 + i * 70) + 'ms';\n    if(!hasNight) el.setAttribute('data-fallback','1');\n\n    var html = '<img class=\"rt-panel__img rt-panel__img--day\" src=\"'\n      + (p.day || placeholder(p.label, i)) + '\" alt=\"' + p.label\n      + '\" loading=\"eager\" decoding=\"async\">';\n    if(hasNight){\n      html += '<img class=\"rt-panel__img rt-panel__img--night\" src=\"'+p.night\n        + '\" alt=\"\" aria-hidden=\"true\" loading=\"eager\" decoding=\"async\">';\n    }\n    html += '<span class=\"rt-panel__tone\" aria-hidden=\"true\"></span>';\n    html += '<p class=\"rt-panel__cap\">'+p.label+'</p>';\n    if(p.href) html += '<a class=\"rt-panel__link\" href=\"'+p.href+'\" aria-label=\"'+p.label+'\"></a>';\n    el.innerHTML = html;\n\n    css.push('#'+id+'{grid-area:'+p.area+';}');\n    if(p.pos) css.push('#'+id+' .rt-panel__img{object-position:'+p.pos+';}');\n    if(p.mobile) css.push('@media (max-width:900px){#'+id+'{grid-area:'+p.mobile+';}}');\n\n    frag.appendChild(el);\n  });\n\n  grid.insertBefore(frag, brand);\n\n  var style = document.createElement('style');\n  style.textContent = css.join('\\n');\n  document.head.appendChild(style);\n\n  var toggle = hero.querySelector('.rt-toggle');\n  var btns = hero.querySelectorAll('.rt-toggle__btn');\n  var ctaEl = document.getElementById('rt-cta');\n  var ctaLabelEl = document.getElementById('rt-cta-label');\n\n  function applyCta(mode){\n    var cfg = RT_CTA[mode] || RT_CTA.day;\n    if(ctaLabelEl) ctaLabelEl.textContent = cfg.label;\n    if(ctaEl) ctaEl.setAttribute('href', cfg.href);\n  }\n  applyCta('day');\n\n  var hint = document.getElementById('rt-hint');\n  var inviteTimer = null;\n\n  function stopInvite(){\n    if(inviteTimer){ clearTimeout(inviteTimer); inviteTimer = null; }\n    toggle.classList.remove('is-inviting');\n    if(hint) hint.hidden = true;\n  }\n  function startInvite(){\n    inviteTimer = setTimeout(function(){\n      toggle.classList.add('is-inviting');\n    }, 1400);\n  }\n\n  if('IntersectionObserver' in window){\n    var io = new IntersectionObserver(function(entries){\n      entries.forEach(function(en){\n        if(en.isIntersecting){ startInvite(); io.disconnect(); }\n      });\n    }, { threshold:.4 });\n    io.observe(hero);\n  } else {\n    startInvite();\n  }\n\n  function setMode(mode){\n    if(hero.dataset.mode === mode) return;\n    hero.dataset.mode = mode;\n    btns.forEach(function(b){\n      var on = b.dataset.mode === mode;\n      b.classList.toggle('is-active', on);\n      b.setAttribute('aria-pressed', on ? 'true' : 'false');\n    });\n    applyCta(mode);\n    stopInvite();\n  }\n\n  btns.forEach(function(b){\n    b.addEventListener('click', function(){ setMode(b.dataset.mode); });\n  });\n  toggle.addEventListener('keydown', function(e){\n    if(e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;\n    e.preventDefault();\n    setMode(e.key === 'ArrowRight' ? 'night' : 'day');\n    hero.querySelector('.rt-toggle__btn.is-active').focus();\n  });\n\n  var raf = null;\n  hero.addEventListener('pointermove', function(e){\n    if(hero.dataset.mode !== 'night' || e.pointerType === 'touch') return;\n    var r = hero.getBoundingClientRect();\n    var mx = ((e.clientX - r.left) / r.width) * 100;\n    var my = ((e.clientY - r.top) / r.height) * 100;\n    if(raf) return;\n    raf = requestAnimationFrame(function(){\n      hero.style.setProperty('--rt-mx', mx + '%');\n      hero.style.setProperty('--rt-my', my + '%');\n      raf = null;\n    });\n  });\n\n  /* Preloading night frames now waits for window 'load' instead of\n     firing instantly, so it no longer competes with the hero's own\n     visible images (or the rest of the page) for bandwidth during\n     first paint/LCP. */\n  function preloadNight(){\n    RT_PANELS.forEach(function(p){ if(p.night){ var im = new Image(); im.src = p.night; } });\n  }\n  if(document.readyState === 'complete'){\n    preloadNight();\n  } else {\n    window.addEventListener('load', preloadNight, { once:true });\n  }\n})();\n</script>",
