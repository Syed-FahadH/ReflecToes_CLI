ervice\">Terms of Service</a></p>\n      <p><a href=\"/policies/privacy-policy\">Privacy Policy</a></p>\n      <p><a href=\"/policies/refund-policy\">Refund Policy</a></p>\n      <p><a href=\"/policies/shipping-policy\">Shipping Policy</a></p>\n      <p><a href=\"/pages/faqs\">FAQs</a></p>\n    </div>\n\n    <div class=\"reflec-footer-column\">\n      <h4>Subscribe</h4>\n      <p>Sign up to our mailing list</p>\n      <form method=\"post\" action=\"/contact#reflec-footer-sub\" accept-charset=\"UTF-8\" id=\"reflec-footer-sub\">\n        <input type=\"hidden\" name=\"form_type\" value=\"customer\">\n        <input type=\"hidden\" name=\"utf8\" value=\"✓\">\n        <input type=\"hidden\" name=\"contact[tags]\" value=\"footer-newsletter\">\n        <input type=\"email\" name=\"contact[email]\" placeholder=\"Your Email\" required>\n        <button type=\"submit\">Subscribe</button>\n      </form>\n      <p id=\"reflec-footer-thanks\" style=\"display:none;color:#4CAF50;margin-top:0.5rem;\">Thanks! You're subscribed.</p>\n      <script>if(window.location.search.indexOf('customer_posted=true')!==-1){var rfT=document.getElementById('reflec-footer-thanks');if(rfT){rfT.style.display='block';}var rfF=document.getElementById('reflec-footer-sub');if(rfF){rfF.style.display='none';}}</script>\n\n      <div class=\"social-icons\">\n        <a href=\"https://www.facebook.com/reflectoes/\" target=\"_blank\" aria-label=\"Facebook\"><i class=\"fab fa-facebook-f\"></i></a>\n        <a href=\"https://www.instagram.com/reflectoes/\" target=\"_blank\" aria-label=\"Instagram\"><i class=\"fab fa-instagram\"></i></a>\n      </div>\n    </div>\n  </footer>\n\n  <link\n    rel=\"stylesheet\"\n    href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css\"\n    media=\"print\"\n    onload=\"this.media='all'\">\n</div>",
