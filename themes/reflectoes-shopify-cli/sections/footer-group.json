        "custom_liquid": "<div>\n  <style>\n    .reflec-footer {\n      width: 100%;\n      background-color: #111;\n      color: #eee;\n      font-family: 'Manrope', sans-serif;\n      padding: 2rem;\n      display: flex;\n      flex-wrap: wrap;\n      justify-content: center;\n      gap: 6rem;\n      box-sizing: border-box;\n    }\n\n    .shopify-section-group-footer-group {\n      background-color: #111111;\n    }\n\n    .reflec-footer-column {\n      display: flex;\n      flex-direction: column;\n      min-width: 240px;\n      max-width: 320px;\n      text-align: left;\n    }\n\n    .reflec-footer h4 {\n      font-size: 1.3rem;\n      font-weight: 600;\n      margin-bottom: 1rem;\n      text-transform: uppercase;\n      color: #ccc;\n    }\n\n    .reflec-footer p,\n    .reflec-footer a {\n      font-size: 0.95rem;\n      line-height: 1.4;\n      color: #ccc;\n      text-decoration: none;\n      margin: 0.3rem 0;\n      transition: color 0.3s ease;\n    }\n\n    .reflec-footer a:hover {\n      color: #888;\n      text-decoration: underline;\n    }\n\n    .reflec-footer-column.info-links a:hover {\n      color: #888 !important;\n    }\n\n    .footer-spaced {\n      margin-top: 0.8rem;\n    }\n\n    .footer-address {\n      margin-top: 0.8rem;\n      line-height: 1.5;\n    }\n\n    .reflec-footer form {\n      margin-top: 1rem;\n      display: flex;\n      flex-direction: row;\n      gap: 0.5rem;\n      align-items: center;\n      flex-wrap: wrap;\n    }\n\n    .reflec-footer input[type=\"email\"] {\n      padding: 1rem;\n      width: 100%;\n      max-width: 260px;\n      border-radius: 6px;\n      border: none;\n      font-size: 1.05rem;\n      background-color: #222;\n      color: #eee;\n      caret-color: #eee;\n    }\n\n    .reflec-footer input[type=\"email\"]::placeholder {\n      color: #aaa;\n    }\n\n    .reflec-footer input[type=\"email\"]:focus {\n      outline: 2px solid #4CAF50;\n    }\n\n    .reflec-footer button {\n      padding: 1rem 1.6rem;\n      background: #4CAF50;\n      color: white;\n      border: none;\n      border-radius: 6px;\n      font-weight: 600;\n      font-size: 1.1rem;\n      cursor: pointer;\n      transition: background 0.3s ease, color 0.3s ease;\n    }\n\n    .reflec-footer button:hover {\n      background: white;\n      color: #888;\n    }\n\n    .social-icons {\n      margin-top: 1.2rem;\n      display: flex;\n      gap: 1rem;\n    }\n\n    .social-icons a {\n      color: #ccc;\n      font-size: 1.5rem;\n      transition: color 0.3s ease;\n    }\n\n    .social-icons a:hover {\n      color: #888;\n    }\n\n    .payment-icons {\n      margin-top: 1.2rem;\n      display: flex;\n      flex-wrap: wrap;\n      gap: 0.5rem;\n    }\n\n    .payment-icon {\n      width: 40px;\n      height: 24px;\n      background-color: #fff;\n      border-radius: 4px;\n      overflow: hidden;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n\n    .payment-icon img {\n      width: 100%;\n      height: 100%;\n      object-fit: contain;\n      display: block;\n    }\n\n    @media (max-width: 768px) {\n      .reflec-footer {\n        flex-direction: column;\n        align-items: center;\n        text-align: center;\n        gap: 3rem;\n      }\n\n      .reflec-footer-column {\n        align-items: center;\n        text-align: center;\n      }\n\n      .reflec-footer form {\n        flex-direction: column;\n        align-items: center;\n      }\n\n      .social-icons,\n      .payment-icons {\n        justify-content: center;\n      }\n    }\n  </style>\n\n  <footer class=\"reflec-footer\">\n    <div class=\"reflec-footer-column\">\n      <h4>ReflecToes Store</h4>\n      <p>© REFLECTOES</p>\n      <p>ReflecToes is a brand of OH SUSANNAH LLC</p>\n      <p class=\"footer-spaced\"><a href=\"tel:+12314894891\">231-489-4891</a></p>\n      <p><a href=\"mailto:info@reflectoes.com\">info@reflectoes.com</a></p>\n      <p class=\"footer-address\">5565 S Bronze Plateau Cir<br>Saint George